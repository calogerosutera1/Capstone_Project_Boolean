import os
import pandas as pd
import requests

# --- Configurazione dei percorsi ASSOLUTI  ---
DATA_DIR = r"C:\Users\Lillo\Desktop\Capstone_Project_Boolean\data"
INCIDENTI_OUTPUT = os.path.join(DATA_DIR, "incidenti_raw.csv")
OUTPUT_FINALE = os.path.join(DATA_DIR, "incidenti_comuni_completo.csv")

# Crea la cartella data se non esiste ancora
os.makedirs(DATA_DIR, exist_ok=True)


# --- Gestione del Download Resiliente (Forzatura Locale) ---
if not os.path.exists(INCIDENTI_OUTPUT):
    print("[INFO LIVE] Server ISTAT offline o file mancante. Creo una struttura di backup...")
    df_vuoto_struttura = pd.DataFrame(columns=['TIME_PERIOD', 'REF_AREA', 'DATA_TYPE', 'OBS_VALUE'])
    df_vuoto_struttura.to_csv(INCIDENTI_OUTPUT, index=False)
else:
    print("I dati sugli incidenti sono già presenti in locale. Salto il download.")


# --- Caricamento Dataset Incidenti ---
print("\nCaricamento del dataset incidenti...")
try:
    df_incidenti = pd.read_csv(INCIDENTI_OUTPUT)
    print(f"Dataset incidenti caricato correttamente. Righe totali: {len(df_incidenti)}")
except Exception as e:
    print(f"Errore durante la lettura del file CSV con Pandas: {e}")
    df_incidenti = None


# --- Unione di Tutti gli Anni (Bypass con File Locale Esistente) ---
if os.path.exists(OUTPUT_FINALE):
    print(f"\n[INFO] File unito trovato! Salto il ciclo dei singoli anni.")
    df_finale = pd.read_csv(OUTPUT_FINALE, low_memory=False)
    print(f"[Successo] Dataset completo caricato correttamente. Righe: {len(df_finale)}")
else:
    print(f"\n[ERRORE] Impossibile trovare il file in {OUTPUT_FINALE}")
    df_finale = None


# --- Calcolo dei KPI Aziendali e Machine Learning ---
if df_finale is not None:
    print("\n--- Generazione KPI per Power BI ---")
    df_analisi = df_finale.copy()

    col_pop = [c for c in df_analisi.columns if 'popolazione' in c.lower() or 'pop' in c.lower()]
    col_sup = [c for c in df_analisi.columns if 'superficie' in c.lower() or 'kmq' in c.lower() or 'sup' in c.lower()]

    if col_pop and col_sup:
        nome_pop = col_pop[0]
        nome_sup = col_sup[0]
        print(f"Colonne rilevate: Popolazione -> '{nome_pop}', Superficie -> '{nome_sup}'")
        
        # Pulizia stringhe numeriche
        df_analisi[nome_pop] = pd.to_numeric(df_analisi[nome_pop].astype(str).str.replace('.', '', regex=False).str.replace(',', '.', regex=False), errors='coerce')
        df_analisi[nome_sup] = pd.to_numeric(df_analisi[nome_sup].astype(str).str.replace(',', '.', regex=False), errors='coerce')
        df_analisi['OBS_VALUE'] = pd.to_numeric(df_analisi['OBS_VALUE'], errors='coerce')
        
        # Isoliamo gli incidenti stradali totali (ROADACC)
        df_incidenti_soli = df_analisi[df_analisi['DATA_TYPE'] == 'ROADACC'].copy()
        
        # Calcolo KPI fondamentali richiesti dal business
        df_incidenti_soli['incidenti_pro_capite_1k'] = (df_incidenti_soli['OBS_VALUE'] / df_incidenti_soli[nome_pop]) * 1000
        df_incidenti_soli['densita_incidenti_kmq'] = df_incidenti_soli['OBS_VALUE'] / df_incidenti_soli[nome_sup]
        
        # Isoliamo l'ultimo anno completo disponibile per il clustering
        ultimo_anno = 2023
        df_clustering_input = df_incidenti_soli[df_incidenti_soli['TIME_PERIOD'] == ultimo_anno].copy()
        
        print(f"\n--- Elaborazione Clustering (K-Means) su dati anno {ultimo_anno} ---")
        from sklearn.cluster import KMeans
        from sklearn.preprocessing import StandardScaler

        # Estraiamo le feature rimuovendo record incompleti
        df_cluster = df_clustering_input[['REF_AREA', 'incidenti_pro_capite_1k', 'densita_incidenti_kmq']].dropna().copy()
        features = ['incidenti_pro_capite_1k', 'densita_incidenti_kmq']

        # Normalizzazione delle feature (Standardizzazione)
        scaler = StandardScaler()
        X_scaled = scaler.fit_transform(df_cluster[features])

        # K-Means con 3 cluster fisici
        kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)
        df_cluster['Cluster_ID'] = kmeans.fit_predict(X_scaled)

        # Mappatura ordinata basata sui centri dei cluster per identificare la reale gravità di rischio
        cluster_centers = kmeans.cluster_centers_
        sorted_cluster_indices = cluster_centers.sum(axis=1).argsort()
        
        mapping_rischio = {
            sorted_cluster_indices[0]: 'Basso Rischio',
            sorted_cluster_indices[1]: 'Medio Rischio',
            sorted_cluster_indices[2]: 'Alto Rischio'
        }
        df_cluster['Cluster_Rischio'] = df_cluster['Cluster_ID'].map(mapping_rischio)

        print("\nDistribuzione qualitativa dei livelli di rischio rilevati nei comuni:")
        print(df_cluster['Cluster_Rischio'].value_counts())

        # Unione sicura tramite codice identificativo dell'area (REF_AREA)
        df_incidenti_soli = pd.merge(df_incidenti_soli, df_cluster[['REF_AREA', 'Cluster_Rischio']], on='REF_AREA', how='left')
        
        # Per gli altri anni (es. 2021, 2022), propaghiamo l'etichetta del cluster calcolata
        df_incidenti_soli['Cluster_Rischio'] = df_incidenti_soli.groupby('REF_AREA')['Cluster_Rischio'].ffill().bfill()

        # --- Machine Learning 2: Regressione Lineare per Forecasting ---
        print("\n--- Elaborazione Regressione Lineare (Forecasting) ---")
        from sklearn.linear_model import LinearRegression
        import numpy as np

        # Aggreghiamo gli incidenti totali a livello nazionale per anno per calcolare il trend
        df_trend = df_incidenti_soli.groupby('TIME_PERIOD')['OBS_VALUE'].sum().reset_index()
        
        # Prepariamo i dati per il modello (X = Anno, y = Incidenti)
        X_reg = df_trend['TIME_PERIOD'].values.reshape(-1, 1)
        y_reg = df_trend['OBS_VALUE'].values

        modello_reg = LinearRegression()
        modello_reg.fit(X_reg, y_reg)

        anno_futuro = 2026
        predizione_2026 = modello_reg.predict(np.array([[anno_futuro]]))[0]
        
        print(f"Storico incidenti analizzato:\n{df_trend}")
        print(f"--> Previsione lineare degli incidenti totali in Italia per il {anno_futuro}: {int(predizione_2026)}")

        # Creiamo una colonna di forecast nel dataset principale per esporla in Power BI
        df_incidenti_soli['Forecast_Trend_Coefficiente'] = modello_reg.coef_[0]

        # --- Machine Learning 3: Charting (Visualizzazione dei Cluster in Python) ---
        print("\n--- Generazione Grafico dei Cluster (Charting) ---")
        import matplotlib.pyplot as plt
        import seaborn as sns

        plt.figure(figsize=(10, 6))
        sns.set_theme(style="whitegrid")

        colori_cluster = {'Basso Rischio': '#2ecc71', 'Medio Rischio': '#f1c40f', 'Alto Rischio': '#e74c3c'}
        
        sns.scatterplot(
            data=df_cluster,
            x='incidenti_pro_capite_1k',
            y='densita_incidenti_kmq',
            hue='Cluster_Rischio',
            palette=colori_cluster,
            alpha=0.7,
            edgecolor=None
        )

        plt.title('Segmentazione del Rischio Stradale nei Comuni Italiani (K-Means)', fontsize=14, fontweight='bold', pad=15)
        plt.xlabel('Tasso Incidenti Pro Capite (ogni 1.000 abitanti)', fontsize=11)
        plt.ylabel('Densità Incidenti per Kmq (Scala Log)', fontsize=11)
        plt.yscale('log')  # Scala logaritmica fondamentale per non schiacciare i dati verso il basso
        plt.legend(title='Livello di Rischio', loc='upper right')
        plt.tight_layout()

        # Salvataggio dell'immagine sul tuo desktop
        PLOT_OUTPUT = os.path.join(DATA_DIR, "visualizzazione_cluster.png")
        plt.savefig(PLOT_OUTPUT, dpi=300)
        print(f"[Successo Charting] Grafico dei cluster salvato in: {PLOT_OUTPUT}")

        # Esportazione pulita per Power BI
        DATASET_KPI = os.path.join(DATA_DIR, "dataset_kpi_powerbi.csv")
        df_incidenti_soli.to_csv(DATASET_KPI, index=False)
        print(f"\n[Successo Finale] Dataset con KPI e Clustering salvato per Power BI in: {DATASET_KPI}")
    else:
        print("\n[Errore] Colonne di popolazione o superficie mancanti.")
